# Slack Socket Mode app-level token used by the local console connector.
SLACK_APP_TOKEN=xapp-your-slack-app-level-token

# Worker endpoint called by the local console connector.
WORKER_AGENT_URL=http://localhost:8787/agent/run

# Shared secret used by the connector and Worker agent endpoint.
# For deployed Workers, set the Worker value with:
# npx wrangler secret put WORKER_CONNECTOR_TOKEN
WORKER_CONNECTOR_TOKEN=replace-with-a-local-shared-secret

# AI Gateway logging defaults. These values are also defined as non-secret
# Wrangler vars in wrangler.jsonc so generated Env types stay in sync.
AI_GATEWAY_ID=default
AI_GATEWAY_COLLECT_LOGS=true
AI_GATEWAY_SOURCE=slack-socket-mode
