{
  "name": "slack-ai-agent-v2",
  "main": "src/cmd/worker.ts",
  "compatibility_date": "2026-06-04",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SLACK_CONVERSATION_AGENT",
        "class_name": "SlackConversationAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SlackConversationAgent"]
    }
  ],
  "vars": {
    "AI_GATEWAY_ID": "default",
    "AI_GATEWAY_COLLECT_LOGS": true,
    "AI_GATEWAY_SOURCE": "slack-socket-mode"
  }
}
