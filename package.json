{
  "name": "slack-ai-agent-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "connector:slack": "tsx --env-file=.env src/cmd/connector.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "npm run typecheck:worker && npm run typecheck:connector",
    "typecheck:worker": "tsc --noEmit",
    "typecheck:connector": "tsc -p tsconfig.connector.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "wrangler": "^4.97.0"
  },
  "dependencies": {
    "ws": "^8.21.0"
  }
}
